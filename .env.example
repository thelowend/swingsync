# SwingSync default music library roots.
#
# Semicolon-separated form is recommended, especially on Windows because
# drive letters contain colons.
#
# Windows example:
SWINGSYNC_MUSIC_FOLDERS=D:\Music\Swing;D:\Music\Boogie;E:\Dance Music

# macOS / Linux example:
# SWINGSYNC_MUSIC_FOLDERS=/Users/you/Music/Swing;/Volumes/Music/Boogie

# A JSON array is also supported. Remember to escape backslashes in JSON:
# SWINGSYNC_MUSIC_FOLDERS=["D:\\Music\\Swing","E:\\Dance Music"]
