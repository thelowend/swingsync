{
  "name": "swingsync",
  "version": "0.15.2",
  "private": true,
  "description": "SwingSync multilingual desktop and CLI app for swing/boogie-aware tempo analysis, review, and BPM metadata synchronization.",
  "main": "src/client/public-api.cjs",
  "scripts": {
    "start": "npm run desktop:dev",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "vite build --config desktop/vite.config.mjs",
    "desktop:run": "npm run desktop:build && electron desktop",
    "cli": "node index.cjs",
    "benchmark": "node index.cjs --benchmark benchmark.json"
  },
  "dependencies": {
    "essentia.js": "*",
    "ffmpeg-static": "5.3.0",
    "music-metadata": "^11.16.0",
    "dotenv": "^16.4.7"
  },
  "bin": {
    "swingsync": "index.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
