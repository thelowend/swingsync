{
  "name": "swingsync",
  "version": "0.15.21.1",
  "private": true,
  "description": "SwingSync multilingual desktop and CLI app for swing/Boogie-Woogie-aware tempo analysis, review, and BPM metadata synchronization.",
  "main": "src/client/public-api.cjs",
  "scripts": {
    "start": "npm run desktop:dev",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "vite build --config desktop/vite.config.mjs",
    "desktop:run": "npm run desktop:build && electron desktop",
    "cli": "node index.cjs",
    "benchmark": "node index.cjs --benchmark benchmark.json",
    "desktop:font:install": "node scripts/install-manbow-font.cjs",
    "predesktop:dev": "node scripts/check-manbow-font.cjs",
    "predesktop:build": "node scripts/check-manbow-font.cjs",
    "desktop:package:win": "npm run desktop:build && electron-builder --win portable --x64",
    "desktop:package:win:unpacked": "npm run desktop:build && electron-builder --win --x64 --dir",
    "predesktop:package:win": "node scripts/check-windows-package.cjs",
    "predesktop:package:win:unpacked": "node scripts/check-windows-package.cjs",
    "test:packaged": "node scripts/smoke-packaged-windows.cjs",
    "desktop:package:win:smoke": "npm run desktop:package:win:unpacked && npm run test:packaged",
    "desktop:package:win:verified": "npm run desktop:package:win:smoke && electron-builder --win portable --x64"
  },
  "dependencies": {
    "essentia.js": "*",
    "ffmpeg-static": "5.3.0",
    "music-metadata": "^11.16.0",
    "dotenv": "^16.4.7"
  },
  "bin": {
    "swingsync": "index.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.swingsync.desktop",
    "productName": "SwingSync",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraMetadata": {
      "main": "desktop/electron-main.cjs"
    },
    "files": [
      "desktop/dist/**/*",
      "desktop/electron-main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "SwingSync"
    },
    "portable": {
      "artifactName": "SwingSync-${version}-Windows-${arch}.${ext}"
    }
  }
}
