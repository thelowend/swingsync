{
  "name": "swingsync",
  "version": "0.11.1",
  "private": true,
  "description": "SwingSync analyzes musical tempo with swing/boogie-aware interpretation, human review, metadata synchronization, caching and regression benchmarks.",
  "main": "src/client/public-api.cjs",
  "scripts": {
    "start": "node index.cjs",
    "benchmark": "node index.cjs ./TEST --benchmark benchmark.json"
  },
  "dependencies": {
    "essentia.js": "*",
    "ffmpeg-static": "*",
    "music-metadata": "^11.16.0"
  },
  "bin": {
    "swingsync": "index.cjs"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
